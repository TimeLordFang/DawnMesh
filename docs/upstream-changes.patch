+  final end = DateTime.now().add(const Duration(seconds: 3));
+  while (!condition() && DateTime.now().isBefore(end)) {
+    await Future<void>.delayed(const Duration(milliseconds: 10));
+  }
+  expect(condition(), isTrue);
+}
