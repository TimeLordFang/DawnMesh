+                          color: (_enabled
+                                  ? const Color(0xFF4B9A8C)
+                                  : secondary)
+                              .withValues(alpha: 0.14),
+                          borderRadius: BorderRadius.circular(11),
+                        ),
+                        child: Icon(
+                          _enabled
+                              ? Icons.terminal_rounded
